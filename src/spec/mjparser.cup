/*------------------------- PACKAGE AND IMPORT -------------------------*/
package rs.ac.bg.etf.pp1;


import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;



/*------------------------- PACKAGE AND IMPORT END-------------------------*/



/*------------------------- CODE -------------------------*/



parser code {:

	Logger log = Logger.getLogger(getClass());
	boolean error_detected = false; 
   
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSyntax error", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatal error, parsing cannot continue", cur_token);
    }

    public void report_error(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" on line ").append(((Symbol)info).left);
        log.error(msg.toString());
        error_detected = true;
    }


:}


scan with {:
	Symbol s = this.getScanner().next_token();
	//if (s != null && s.value != null) 
		//log.info(s.toString() + " " + s.value.toString());
	return s;
:}



/*------------------------- CODE END -------------------------*/



/*------------------------- TERMINALS AND NONTERMINALS -------------------------*/



/*------------------------- Terminals -------------------------*/

terminal PROG, RETURN;
terminal ENUM, CLASS, EXTENDS, ABSTRACT;
terminal IF, ELSE, FOR, BREAK, CONTINUE, SWITCH, CASE;
terminal CONST, VOID, NEW;
terminal PRINT, READ;
terminal LPAREN, RPAREN, LBRACKET, RBRACKET, LBRACE, RBRACE;
terminal PLUS, MINUS, MUL, DIV, MOD, ASSIGN, INC, DEC;
terminal EQUAL, NOTEQUAL, GT, GTEQ, LT, LTEQ, AND, OR;
terminal SEMI, COLON, COMMA, DOT, QMARK;


terminal String IDENT;
terminal Integer NUMCONST;
terminal Character CHARCONST;
terminal Boolean BOOLCONST;



/*------------------------- Nonterminals -------------------------*/

nonterminal Program;
nonterminal GlobalDeclList, GlobalDecl;
nonterminal ConstDecl, MultConstDecl, SingleConstDecl;													/* Constant related nonterminals */
nonterminal VarDecl, MultVarDecl, ArrayDecl, SingleVarDecl; 											/* Variable related nonterminals */
nonterminal EnumDecl, EnumDeclList, SingleIdentEnumDecl, NumConstAssign;						        /* Enumeration related nonterminals */	
nonterminal ClassDecl, ClassExtension;
nonterminal ExtFieldIntercept, FieldDeclList, FieldDecl;
nonterminal ClassMethods, ExtMethodIntercept, ClassMethodDeclList; 	
nonterminal AbsClassDecl, AbsClassMethods, AbsClassMethodList, AbsMethodDecl, AbsMethodName;
nonterminal SingleGlVarDecl, MultGlVarDecl, GlVarDecl;


nonterminal MethodDeclList, ReturnType, FormalParamList, FormalParams, FormalParam, VarDeclList;
nonterminal StatementList, Statement, DesignatorStatement, ForDesignatorStmnt, ForBeforeCond, ForCondition, ForAfterCond, ForInterrupt, IndexInterrupt;
nonterminal SwitchInterrupt, CaseList, SingleCase, CaseNum;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Condition, CondTerm, CondFact;
nonterminal FCallInterrupt, ActualParamList, MultActualParam;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Expr, Term, TermList, Factor, FactorList;
nonterminal IfBeforeCond, IfAfterCond, ElseInterrupt;
nonterminal TernaryInterrupt, TernaryElse;
nonterminal FactorExprStartIntr, FactorExprEndIntr;

nonterminal Assignop, Relop, Addop, Mulop, OrInterrupt;


nonterminal rs.etf.pp1.symboltable.concepts.Obj ProgramName, EnumName, Type;
nonterminal rs.etf.pp1.symboltable.concepts.Struct ConstVal;
nonterminal rs.etf.pp1.symboltable.concepts.Obj Designator, DesignatorChain, DesignatorDst;
nonterminal rs.etf.pp1.symboltable.concepts.Obj ActualParam;
nonterminal rs.etf.pp1.symboltable.concepts.Obj MethodName, MethodDecl, ClassMethodName, ClassMethodDecl;
nonterminal rs.etf.pp1.symboltable.concepts.Obj ClassName, AbsClassName;


/*------------------------- TERMINALS AND NONTERMINALS END -------------------------*/



/*------------------------- PRECEDENCE -------------------------*/

precedence left ELSE;



/*------------------------- PRECEDENCE END -------------------------*/



/*------------------------- GRAMMAR -------------------------*/


Program 			::= (Program) PROG ProgramName:programName GlobalDeclList LBRACE MethodDeclList RBRACE;


ProgramName			::= (ProgramName) IDENT:programName;



/*------------------------- Non Method Declarations -------------------------*/

GlobalDeclList 		::= (GlobalDecls) GlobalDeclList GlobalDecl
					 	| 
				 	 	(EmptyGlobalDeclList) /* epsilon */;


GlobalDecl 			::= (GlobalConstDecl) ConstDecl
						|
						(GlobalVarDecl) GlVarDecl
						|
						(GlobalClassDecl) ClassDecl
						|
						(GlobalEnumDecl) EnumDecl
						|
						(GlobalAbsClassDecl) AbsClassDecl;
						
						
GlVarDecl			::= (GlVarDecl) Type MultGlVarDecl SEMI;


MultGlVarDecl		::= (MultGlVarDecls) MultGlVarDecl COMMA SingleGlVarDecl
						|
						(FirstGlVarDecl) SingleGlVarDecl; 
						
	
SingleGlVarDecl		::= (SingleGlVarDeclValid) SingleVarDecl
						|
						(SingleGlVarDeclError) error:e
							{: parser.report_error("Invalid global variable declaration on line " + eleft, null); :};
							


/*------------------------- Constant Declaration -------------------------*/

ConstDecl			::= (ConstDecl) CONST Type MultConstDecl SEMI;


MultConstDecl		::= (MultConstDecls) MultConstDecl COMMA SingleConstDecl
						|
						(FirstConstDecl) SingleConstDecl;
						
						
SingleConstDecl		::= (SingleConstDecl) IDENT:constName ASSIGN ConstVal;   


ConstVal			::= (NumConstVal) NUMCONST:val
						|
						(CharConstVal) CHARCONST:val
						|
						(BoolConstVal) BOOLCONST:val;


					
/*------------------------- Variable Declaration -------------------------*/

VarDecl 			::= (VarDecl) Type MultVarDecl SEMI;


MultVarDecl			::= (MultVarDecls) MultVarDecl COMMA SingleVarDecl
						|
						(FirstVarDecl) SingleVarDecl;
						

SingleVarDecl		::= (SingleVarDecl) IDENT:varName ArrayDecl;


ArrayDecl			::= (IsArray) LBRACKET RBRACKET
						|
						(NotArray) /* epsilon */;
						


/*------------------------- Enumeration Declaration -------------------------*/

EnumDecl			::= (EnumDecl) ENUM EnumName LBRACE EnumDeclList RBRACE;


EnumName			::= (EnumName) IDENT:name;


EnumDeclList		::= (EnumDecls) EnumDeclList COMMA SingleIdentEnumDecl
						|
						(FirstIdentEnumDeclList) SingleIdentEnumDecl;
						
						
SingleIdentEnumDecl	::=	(SingleIdentEnumDecl) IDENT:innerEnumName NumConstAssign;
						
						
NumConstAssign		::= (EnumNumConstAssign) ASSIGN NUMCONST:val
						|
						(NoEnumNumConstAssign) /* epsilon */;
					
						

/*------------------------- Class Declaration -------------------------*/
	
ClassDecl			::= (ClassDecl) CLASS ClassName ClassExtension ExtFieldIntercept FieldDeclList ClassMethods RBRACE;


ClassName			::= (ClassName) IDENT:className;


ClassExtension		::= (CExtension) EXTENDS Type
						|
						(CExtensionError) error:e
							{: parser.report_error("Invalid class extension on line " + eleft, null); :}
						|
						(NoCExtension) /* epsilon */;


ExtFieldIntercept	::=	(ExtFieldIntercept) LBRACE;

						
FieldDeclList		::= (FieldDecls) FieldDeclList FieldDecl
						|
						(EmptyFieldDeclList) /* epsilon */;
						
						
FieldDecl			::= (SingleFieldDecl) Type MultVarDecl SEMI
						|
						(FieldDeclError) error SEMI:e
							{: parser.report_error("Invalid class field declaration on line " + eleft, null); :};


ClassMethods		::= (ClassMethodBlock) ExtMethodIntercept ClassMethodDeclList RBRACE 
						|
						(NoClassMethods) /* epsilon */;


ExtMethodIntercept	::= (ExtMethodIntercept) LBRACE;


ClassMethodDeclList	::= (ClassMethodDecls) ClassMethodDeclList ClassMethodDecl
						|
						(EmptyClassMethodDeclList) /* epsilon */;


ClassMethodDecl		::= (ClassMethodDecl) ReturnType ClassMethodName LPAREN FormalParams RPAREN VarDeclList LBRACE StatementList RBRACE;


ClassMethodName		::= (ClassMethodName) IDENT:name;					



/*------------------------- Abstract Class Declaration -------------------------*/
						
AbsClassDecl		::= (AbsClassDecl) ABSTRACT CLASS AbsClassName ClassExtension ExtFieldIntercept FieldDeclList AbsClassMethods RBRACE;


AbsClassName		::= (AbsClassName) IDENT:name;


AbsClassMethods		::= (AbsClassMethodBlock) ExtMethodIntercept AbsClassMethodList RBRACE
						|
						(NoAbsClassMethods) /* epsilon */;


AbsClassMethodList	::= (AbsClassMethodListAbsMethod) AbsClassMethodList AbsMethodDecl
						|
						(AbsClassMethodListConcMethod) AbsClassMethodList ClassMethodDecl
						|
						(EmptyAbsClassMethodList) /* epsilon */;


AbsMethodDecl		::= (AbsMethodDecl) ABSTRACT ReturnType AbsMethodName LPAREN FormalParams RPAREN SEMI;


AbsMethodName		::= (AbsMethodName) IDENT:name;



/*------------------------- Method Declaration -------------------------*/

MethodDeclList		::= (MethodDecls) MethodDeclList MethodDecl
						|
						(EmptyMethodDeclList) /* epsilon */; 


MethodDecl			::= (MethodDecl) ReturnType MethodName LPAREN FormalParams RPAREN VarDeclList LBRACE StatementList RBRACE;


ReturnType			::= (TypeReturn) Type
						|
						(VoidReturn) VOID;
						
						
MethodName			::= (MethodName) IDENT:name;


FormalParams		::= (FormalParamListValid) FormalParamList
						|
						(NoFormalParams) /* epsilon */ ;


FormalParamList		::= (MultFormalParams) FormalParamList COMMA FormalParam
						|
						(FirstFormalParam) FormalParam;


FormalParam 		::= (SingleFormalParam) Type IDENT:paramName ArrayDecl
						|
						(FormalParamError) error:e
							{: parser.report_error("Invalid formal parameter on line " + eleft, null); :};
						

VarDeclList 		::= (VarDecls) VarDeclList VarDecl
						|
						(EmptyVarDeclList) /* epsilon */;


StatementList		::= (Statements) StatementList Statement 
						|
						(EmptyStatementList) /* epsilon */;



/*------------------------- Non primitive Type -------------------------*/

Type				::= (Type) IDENT:typeName;



/*------------------------- Statements -------------------------*/

Statement			::= (GeneralDesignatorStatement) DesignatorStatement SEMI
						|
						(GeneralDesignatorStatementError) error SEMI:e
							{: parser.report_error("Invalid assignment on line " + eleft, null); :}
						|
						(IfStatement) IF IfBeforeCond Condition IfAfterCond Statement
						|
						(IfElseStatement) IF IfBeforeCond Condition IfAfterCond Statement ElseInterrupt Statement
						|
						(IfStatementError) IF LPAREN error RPAREN Statement:e 
							{: parser.report_error("Invalid IF condition on line " + eleft, null); :}
						|
						(IfElseStatementError) IF LPAREN error RPAREN Statement ELSE Statement:e 
							{: parser.report_error("Invalid IF-ELSE condition on line " + eleft, null); :}
						|
						(BreakStatement) BREAK SEMI
						|
						(ContinueStatement) CONTINUE SEMI
						|
						(VoidReturnStatement) RETURN SEMI			/* void function return */
						| 
						(TypedReturnStatement)RETURN Expr SEMI		/* typed function return */
						|
						(ReadStatement) READ LPAREN DesignatorDst RPAREN SEMI
						|
						(PrintStatement) PRINT LPAREN Expr RPAREN SEMI
						|
						(NumConstPrintStatement) PRINT LPAREN Expr COMMA NUMCONST:val RPAREN SEMI
						| 
						(ForStatement) FOR LPAREN ForDesignatorStmnt ForBeforeCond ForCondition ForAfterCond ForDesignatorStmnt ForInterrupt Statement
						|
						(StatementBlock) LBRACE StatementList RBRACE
						|
						(SwitchStatement) SWITCH LPAREN Expr RPAREN SwitchInterrupt CaseList RBRACE;


IfBeforeCond		::= (IfBeforeCond) LPAREN;


IfAfterCond			::= (IfAfterCond) RPAREN;


ElseInterrupt		::= (ElseInterrupt) ELSE; 


ForBeforeCond		::= (ForBeforeCond) SEMI;


ForAfterCond		::= (ForAfterCond) SEMI;


ForInterrupt		::= (ForInterrupt) RPAREN;


ForDesignatorStmnt	::= (ForDesignatorStatement) DesignatorStatement
						|
						(NoForDesignatorStatement) /* epsilon */; 


ForCondition		::= (ForCond) Condition
						|
						(NoForCond) /* epsilon */;
						

SwitchInterrupt		::= (SwitchInterrupt) LBRACE;



CaseList			::= (Cases) CaseList SingleCase 
						|
						(EmptyCaseList) /* epsilon */;
						
						
SingleCase			::= (SingleCase) CASE CaseNum COLON StatementList;


CaseNum				::= (CaseNum) NUMCONST:val;
						
						
					
DesignatorStatement	::= (DesignatorAssignment) DesignatorDst Assignop Expr
						|
						(DesignatorFCall) Designator FCallInterrupt ActualParamList RPAREN
						|
						(DesignatorInc) DesignatorDst INC
						|
						(DesignatorDec) DesignatorDst DEC;
						

DesignatorDst		::=	(DesignatorDst) DesignatorChain;


Designator			::= (Designator) DesignatorChain;


DesignatorChain		::= (DesignatorChainIndexAccess) DesignatorChain:prevDesignator IndexInterrupt Expr RBRACKET 
						|
						(DesignatorChainFieldAccess) DesignatorChain:prevDeisgnator DOT IDENT:fieldName
						|
						(DesignatorChainIdent) IDENT:name;


IndexInterrupt		::=	(IndexInterrupt) LBRACKET;


ActualParamList		::= (ActualParams)  MultActualParam
						|
						(EmptyActualParamList) /* epsilon */;


MultActualParam		::= (MultActualParams) MultActualParam COMMA ActualParam 
						|
						(SingleActualParam) ActualParam;


ActualParam			::= (ActualParam) Expr;
						

Condition			::= (SimpleCondition) CondTerm 
						|
						(OrCondition) Condition OrInterrupt CondTerm;


OrInterrupt			::= (OrInterrupt) OR;


CondTerm			::= (SimpleCondTerm) CondFact
						|
						(AndCondTerm) CondTerm AND CondFact;

								
CondFact			::= (SimpleCondFact) TermList
						|
						(RelopCondFact) TermList Relop TermList;
						
						
Expr				::= (SimpleExpr) TermList
						|
						(TernaryExpr) Condition TernaryInterrupt Expr:trueExpr TernaryElse Expr:falseExpr;
						
						
TernaryInterrupt	::= (TernaryInterrupt) QMARK;


TernaryElse			::= (TernaryElse) COLON;
						
						
TermList			::= (Terms) TermList Addop Term
						|
						(UMinusFirstTermInList) MINUS Term
						|
						(FirstTermInList) Term;


Term				::= (Term) FactorList;


FactorList			::= (Factors) FactorList Mulop Factor
						|
						(FirstFactorInList) Factor;
						
						
Factor				::= (FactorDesignator) Designator
						|
						(FactorFCall) Designator FCallInterrupt ActualParamList RPAREN
						|
						(FactorNumConst) NUMCONST:val
						|
						(FactorCharConst) CHARCONST:val
						|
						(FactorBoolConst) BOOLCONST:val
						|
						(FactorTypeInst) NEW Type
						|
						(FactorArrayInst) NEW Type LBRACKET Expr RBRACKET
						|
						(FactorExpr) FactorExprStartIntr Expr FactorExprEndIntr;
						

FactorExprStartIntr	::= (FactorExprStartIntr) LPAREN;


FactorExprEndIntr	::= (FactorExprEndIntr) RPAREN;


FCallInterrupt		::= (FCallInterrupt) LPAREN;

/*------------------------- Operators -------------------------*/

Assignop			::= (Assign) ASSIGN; 	/* Right associative */


Relop				::= (Equal) EQUAL
						|
						(NotEqual) NOTEQUAL
						|
						(GreaterThan) GT
						|
						(GreaterEqual) GTEQ
						|
						(LesserThan) LT
						|
						(LesserThanEqual) LTEQ;


Addop				::= (Plus) PLUS 	/* Left associative */
						|
						(Minus) MINUS;
						

Mulop				::= (Mul) MUL 	/* Left associative */
						|
						(Div) DIV
						|
						(Mod) MOD;



/*------------------------- GRAMMAR END -------------------------*/
