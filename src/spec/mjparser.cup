/*------------------------- PACKAGE AND IMPORT -------------------------*/
package rs.ac.bg.etf.pp1


import java_cup.runtime.*;
import org.apache.log4j.*;
import rs.ac.bg.etf.pp1.ast.*;



/*------------------------- PACKAGE AND IMPORT END-------------------------*/



/*------------------------- CODE -------------------------*/



parser code {:

	Logger log = Logger.getLogger(getClass());
   
     
    public void report_fatal_error(String message, Object info) throws java.lang.Exception {
      done_parsing();
      report_error(message, info);
    }
  
    public void syntax_error(Symbol cur_token) {
        report_error("\nSintaksna greska", cur_token);
    }
  
    public void unrecovered_syntax_error(Symbol cur_token) throws java.lang.Exception {
        report_fatal_error("Fatalna greska, parsiranje se ne moze nastaviti", cur_token);
    }

    public void report_error(String message, Object info) {
    	StringBuilder msg = new StringBuilder(message); 
    	if (info instanceof Symbol)
            msg.append (" na liniji ").append(((Symbol)info).left);
        log.error(msg.toString());
    }


:}


scan with {:
	Symbol s = this.getScanner().next_token();
	if (s != null && s.value != null) 
		log.info(s.toString() + " " + s.value.toString());
	return s;
:}



/*------------------------- CODE END -------------------------*/



/*------------------------- TERMINALS AND NONTERMINALS -------------------------*/



/*------------------------- Terminals -------------------------*/

terminal PROG, RETURN;
terminal ENUM, CLASS, EXTENDS, ABSTRACT;
terminal IF, ELSE, FOR, BREAK, CONTINUE, SWITCH, CASE;
terminal CONST, VOID, NEW;
terminal PRINT, READ;
terminal LPAREN, RPAREN, LBRACKET, RBRACKET, LBRACE, RBRACE;
terminal PLUS, MINUS, MUL, DIV, MOD, ASSIGN, INC, DEC;
terminal EQUAL, NOTEQUAL, GT, GTEQ, LT, LTEQ, AND, OR;
terminal SEMI, COLON, COMMA, DOT, QMARK;


terminal String IDENT;
terminal Integer NUMCONST;
terminal Character CHARCONST;
terminal Boolean BOOLCONST;



/*------------------------- Nonterminals -------------------------*/

nonterminal Program;
nonterminal GlobalDeclList, GlobalDecl;
nonterminal ConstDecl, ConstVal, MultConstDecl;			/* Constant related nonterminals */
nonterminal VarDecl, MultVarDecl, ArrayDecl; 			/* Variable related nonterminals */
nonterminal EnumDecl, EnumDeclList, NumConstAssign;		/* Enumeration related nonterminals */
nonterminal ClassDecl, ClassExtension, FieldDeclList, ClassMethods, ClassMethodDeclList; 	/* Class related nonterminals */
nonterminal AbsClassDecl, AbsClassMethods, AbsClassMethodList, AbsMethodDecl;

nonterminal MethodDeclList, MethodDecl, ReturnType, FormalParamList, FormalParam, MultFormalParam, VarDeclList;
nonterminal StatementList, Statement, Designator, DesignatorStatement, ForDesignatorStmnt, ForCondition, CaseList;
nonterminal Condition, CondTerm, MultCondTerm, CondFact, MultCondFact;
nonterminal Expr, Term, TermList, Factor, FactorList;

nonterminal Assignop, Relop, Addop, Mulop;



/*------------------------- TERMINALS AND NONTERMINALS END -------------------------*/



/*------------------------- PRECEDENCE -------------------------*/

precedence left ELSE;



/*------------------------- PRECEDENCE END -------------------------*/



/*------------------------- GRAMMAR -------------------------*/


Program 			::= PROG IDENT GlobalDeclList LBRACE MethodDeclList RBRACE;


/*------------------------- Non Method Declarations -------------------------*/

GlobalDeclList 		::= GlobalDeclList GlobalDecl
				 	| 
			 	 	/* epsilon */;


GlobalDecl 			::= ConstDecl
					|
					VarDecl
					|
					ClassDecl
					|
					EnumDecl
					|
					AbsClassDecl;
				


/*------------------------- Constant Declaration -------------------------*/

ConstDecl			::= CONST Type IDENT ASSIGN ConstVal MultConstDecl SEMI;


MultConstDecl		::= MultConstDecl COMMA IDENT ASSIGN ConstVal
						|
						/* epsilon */;  


ConstVal			::= NUMCONST
						|
						CHARCONST
						|
						BOOLCONST;


					
/*------------------------- Variable Declaration -------------------------*/

VarDecl 			::= Type IDENT ArrayDecl MultVarDecl SEMI;


MultVarDecl			::= MultVarDecl COMMA IDENT ArrayDecl
						|
						/* epsilon */;


ArrayDecl			::= LBRACKET RBRACKET
						|
						/* epsilon */;



/*------------------------- Enumeration Declaration -------------------------*/

EnumDecl			::= ENUM IDENT LBRACE IDENT NumConstAssign EnumDeclList RBRACE;


EnumDeclList		::= EnumDeclList COMMA IDENT NumConstAssign
						|
						/* epsilon */;
						
						
NumConstAssign		::= ASSIGN NUMCONST
						|
						/* epsilon */;
					
						

/*------------------------- Class Declaration -------------------------*/
	
ClassDecl			::= CLASS IDENT ClassExtension LBRACE FieldDeclList ClassMethods RBRACE; 


ClassExtension		::= EXTENDS Type
						|
						/* epsilon */;

						
FieldDeclList		::= FieldDeclList VarDecl
						|
						/* epsilon */;


ClassMethods		::= LBRACE ClassMethodDeclList RBRACE
						|
						/* epsilon */;


ClassMethodDeclList	::= ClassMethodDeclList MethodDecl
						|
						/* epsilon */;
						
						
AbsClassDecl		::= ABSTRACT CLASS IDENT ClassExtension LBRACE FieldDeclList AbsClassMethods RBRACE;


AbsClassMethods		::= LBRACE AbsClassMethodList RBRACE
						|
						/* epsilon */;


AbsClassMethodList	::= AbsClassMethodList AbsMethodDecl
						|
						AbsClassMethodList MethodDecl
						|
						/* epsilon */;


AbsMethodDecl		::= ABSTRACT ReturnType IDENT LPAREN FormalParamList RPAREN SEMI;



/*------------------------- Method Declaration -------------------------*/

MethodDeclList		::= MethodDeclList MethodDecl
						|
						/* epsilon */; 


MethodDecl			::= ReturnType IDENT LPAREN FormalParamList RPAREN VarDeclList LBRACE StatementList RBRACE;


ReturnType			::= Type
						|
						VOID;


FormalParamList		::= FormalParam MultFormalParam
						|
						/* epsilon */;


MultFormalParam		::= MultFormalParam COMMA FormalParam  
					|
					/* epsilon */;
					

FormalParam 		::= Type IDENT ArrayDecl;


VarDeclList 		::= VarDeclList VarDecl
						|
						/* epsilon */;


StatementList		::= StatementList Statement 
						|
						/* epsilon */;



/*------------------------- Non primitive Type -------------------------*/

Type				::= IDENT;



/*------------------------- Statements -------------------------*/

Statement			::= DesignatorStatement SEMI
						|
						IF LPAREN Condition RPAREN Statement
						|
						IF LPAREN Condition RPAREN Statement ELSE Statement
						|
						BREAK SEMI
						|
						CONTINUE SEMI
						|
						RETURN SEMI			/* void function return */
						| 
						RETURN Expr SEMI	/* typed function return */
						|
						READ LPAREN Designator RPAREN SEMI
						|
						PRINT LPAREN Expr RPAREN SEMI
						|
						PRINT LPAREN Expr COMMA NUMCONST RPAREN SEMI
						| 
						FOR LPAREN ForDesignatorStmnt SEMI ForCondition SEMI ForDesignatorStmnt RPAREN Statement
						|
						LBRACE StatementList RBRACE
						|
						SWITCH LPAREN Expr RPAREN LBRACE CaseList RBRACE;


ForDesignatorStmnt	::= DesignatorStatement
						|
						/* epsilon */; 


ForCondition		::= Condition
						|
						/* epsilon */;
						

CaseList			::= CaseList CASE NUMCONST COLON StatementList
						|
						/* epsilon */;
						
					
DesignatorStatement	::= Designator Assignop Expr
						|
						Designator LPAREN ActualParamList RPAREN
						|
						Designator INC
						|
						Designator DEC;
						

Designator			::= DesignatorChain;


DesignatorChain		::= DesignatorChain LBRACKET Expr RBRACKET 
						|
						DesignatorChain DOT IDENT
						|
						IDENT;


ActualParamList		::= ActualParam MultActualParam
						|
						/* epsilon */;


MultActualParam		::= MultActualParam COMMA ActualParam 
						|
						/* epsilon */;


ActualParam			::= Expr;


Condition			::= CondTerm MultCondTerm;


MultCondTerm		::= MultCondTerm OR CondTerm 
						|
						/* epsilon */;


CondTerm			::= CondFact MultCondFact;


MultCondFact		::= MultCondFact AND CondFact 
						|
						/* epsilon */;
		
						
CondFact			::= Expr
						|
						Expr Relop Expr;
						
						
Expr				::= TermList
						|
						Condition QMARK Expr COLON Expr;
						
						
TermList			::= TermList Addop Term
						|
						MINUS Term;
						|
						Term;


Term				::= FactorList;


FactorList			::= FactorList Mulop Factor
						|
						Factor;
						
						
Factor				::= Designator
						|
						Designator LPAREN ActualParamList RPAREN
						|
						NUMCONST
						|
						CHARCONST
						|
						BOOLCONST
						|
						NEW Type
						|
						NEW Type LBRACKET Expr RBRACKET
						|
						LPAREN Expr RPAREN;



/*------------------------- Operators -------------------------*/

Assignop			::= ASSIGN 	/* Right associative */


Relop				::= EQUAL
						|
						NOTEQUAL
						|
						GT
						|
						GTEQ
						|
						LT
						|
						LTEQ;


Addop				::= PLUS 	/* Left associative */
						|
						MINUS;
						

Mulop				::= MUL 	/* Left associative */
						|
						DIV
						|
						MOD;



/*------------------------- GRAMMAR END -------------------------*/
